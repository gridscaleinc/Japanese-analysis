// AI 调用接口配置（提交到仓库，不含真实密钥）
// 真实密钥请放在 AIConfig.local.xcconfig（已被 .gitignore 忽略）
//
// 变量说明：
//   AI_API_KEY  —— 直连第三方（DeepSeek/OpenAI）时的 API Key；默认空（走 AICommerce 动态令牌）
//   AI_BASE_URL —— 直连时的基础地址
//   AI_MODEL    —— 默认模型名

// 默认值（可被下方 local 文件覆盖）
AI_API_KEY  =
AI_BASE_URL = https://api.deepseek.com
AI_MODEL = deepseek-chat

// 本地覆盖（文件不存在时不报错）。放在最后，保证本地值优先。
#include? "AIConfig.local.example.xcconfig"